{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flp.fusionlayer.app/schema/v1/pack",
  "title": "FLP Pack",
  "description": "Versioned bundle of multiple FLP primitives distributed and installed as a unit.",
  "type": "object",
  "required": ["kind", "version", "id", "name", "primitives"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "pack" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": {
      "type": "string",
      "pattern": "^@[\\w-]+\\/[\\w-]+$",
      "description": "Scoped identifier, e.g. '@acme/code-review-pack'."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "author": { "type": "string" },
    "license": { "type": "string", "description": "SPDX license identifier (e.g. 'MIT', 'Apache-2.0')." },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["policy", "guideline", "intent", "strategy", "behavior", "playbook", "routine", "template"]
          },
          "ref": {
            "type": "string",
            "description": "Scoped primitive ID (e.g. '@acme/redact-pii') or relative path."
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Discovery tags."
    }
  }
}
