{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flp.fusionlayer.app/schema/v1/pack",
  "title": "FLP Pack",
  "description": "Versioned bundle of multiple FLP primitives distributed and installed as a unit.",
  "type": "object",
  "required": ["kind", "version", "id", "name", "primitives"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "pack" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": {
      "type": "string",
      "pattern": "^@[\\w-]+\\/[\\w-]+$",
      "description": "Scoped identifier, e.g. '@acme/code-review-pack'."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "author": { "type": "string" },
    "license": { "type": "string", "description": "SPDX license identifier (e.g. 'MIT', 'Apache-2.0')." },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["policy", "guideline", "intent", "strategy", "behavior", "playbook", "routine", "template"]
          },
          "ref": {
            "type": "string",
            "description": "Scoped primitive ID (e.g. '@acme/redact-pii') or relative path."
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Optional AAP v0.1 Action Descriptor bindings bundled with or referenced by this Agent Pack.",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Machine-readable snake_case AAP action name (e.g. 'search_web')."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Scoped AAP action ID (e.g. '@fl/search_web') or relative path to an .aap.json descriptor."
          },
          "descriptor_signature": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Canonical SHA-256 signature of the AAP v0.1 Action Descriptor."
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["none", "network", "file_read", "file_write", "database_read", "database_write", "ui", "process", "secret_access", "external_api"]
            },
            "uniqueItems": true
          },
          "on_side_effect": {
            "type": "string",
            "enum": ["allow", "confirm", "deny"],
            "description": "Pack-level default confirmation policy when this action is invoked."
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Discovery tags."
    }
  }
}
